# Copy to .env for local reference, or set these in the Vercel dashboard
# (Project settings -> Environment Variables). Never commit real values.

# Shared passcode for /admin/notes. Pick something long and random — this is
# the only thing standing between the public internet and your GitHub repo.
NOTES_ADMIN_PASSCODE=

# A GitHub fine-grained personal access token, scoped to ONLY this repo
# (nordahl-resume), with Contents: Read and write permission and nothing
# else. Generate at https://github.com/settings/tokens?type=beta
NOTES_GITHUB_TOKEN=
